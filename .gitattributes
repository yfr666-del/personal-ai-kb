# 让 git 自动处理换行符，避免每次提交都刷 LF/CRLF 的 warning
* text=auto

# 文本文件统一用 LF 存
*.py  text eol=lf
*.md  text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf

# Windows 批处理脚本必须用 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二进制文件不碰
*.pdf  binary
*.docx binary
*.png  binary
*.jpg  binary
*.zip  binary
